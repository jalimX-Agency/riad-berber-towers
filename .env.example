# Copy to .env and fill in. Database: Neon (dev branch locally, main branch in production).
DATABASE_URL=""   # Neon pooled URL (host contains -pooler), dev branch
DIRECT_URL=""     # Neon direct URL (same branch, no -pooler), used by prisma db push
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""          # openssl rand -base64 32
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# First admin account created by npm run db:seed
SEED_ADMIN_EMAIL="admin@riadberbertowers.local"
SEED_ADMIN_PASSWORD=""      # strong password for the first admin
# Cloudflare R2 (fill in when the bucket exists)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
NEXT_PUBLIC_R2_URL=""
# Resend (fill in when the domain is verified)
RESEND_API_KEY=""
EMAIL_FROM="Riad Berber Towers <reservations@riadberbertowers.com>"
EMAIL_ADMIN="riadberbertowers@gmail.com"
# iCal export links for Booking.com / Airbnb are signed with ICAL_SECRET (falls back to NEXTAUTH_SECRET).
# Set it once and never change it: changing it changes every export link pasted on the platforms.
ICAL_SECRET=""              # openssl rand -hex 32
# Scheduled iCal import: GET /api/cron/ical with "Authorization: Bearer <CRON_SECRET>" (Vercel Cron sends it)
CRON_SECRET=""              # openssl rand -hex 32

# Optional fallback: the PayPal.me name and the notification email are managed in /admin/settings
PAYPAL_ME=""
